# API base URLs
# These are read at build time by webpack (Dotenv + DefinePlugin) and inlined
# into the bundle via process.env.X references inside src/config/env.ts.
# When a variable is missing, src/config/env.ts falls back to the demo
# localhost value so the dev server can run with no .env file.
CLINIC_API_BASE_URL=http://localhost:4000/api
TRAINING_API_BASE_URL=http://localhost:6090
ASSISTANT_API_BASE_URL=http://localhost:6090

# Set to `true` to produce a bundle-analyzer report at dist/bundle-report.html
# after `npm run build`. Anything other than `true` disables the plugin.
ANALYZE=false

# Firebase Configuration
# Copy this file to .env and fill in your values
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Minimax API endpoint (build-time constant for the React bundle only).
# The actual API key is consumed by the sidecar at runtime via
# `MINIMAX_API_KEY` below — do NOT commit a real key here.
REACT_APP_MINIMAX_API_ENDPOINT=https://api.minimax.chat

# ── Sidecar runtime secrets ─────────────────────────────────────────────
# These are read by `proxy-server/main.py` (FastAPI sidecar) and are NOT
# bundled into the React app. They are shell-only environment variables;
# set them before launching `run_platform.bat` / `uvicorn main:app`.

# D-2: required for destructive endpoints (`POST /api/training/task`,
# `POST /api/training/stop`, `DELETE /api/training/history/{round}`).
# Leave the default value `changeme` ONLY for local development; the
# sidecar will lock destructive routes with 503 if this variable is
# unset/blank, so production deployments must override it with a
# sufficiently random secret.
SIDECAR_ADMIN_TOKEN=changeme

# C-12: API key used by the sidecar `/api/ecg/analyze` route when
# forwarding ECG analysis to Minimax. Leaving this unset causes the
# route to return 503; set it to the real key in production.
MINIMAX_API_KEY=<your-minimax-api-key>

# Optional MiniMax proxy tuning (advanced; defaults are sensible).
# MINIMAX_MODEL=abab6.5s-chat
# MINIMAX_UPSTREAM_URL=https://api.minimax.chat/v1/text/chatcompletion_v2
# MINIMAX_PROXY_TIMEOUT_SECONDS=30

